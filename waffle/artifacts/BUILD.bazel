        "//waffle/contracts/results:attempt",
        "//waffle/contracts/results:provenance",
        "@pip_core//numpy",
    ],
)

waffle_py_test(
    name = "lineage_test",
    deps = [
        ":lineage",
        ":local",
        ":store",
        ":environment",
        "//waffle/contracts/foundation:canonical",
        "//waffle/contracts/foundation:identity",
        "//waffle/contracts/results:artifact",
        "//waffle/contracts/results:provenance",
        "@pip_core//numpy",
    ],
)

waffle_py_test(name = "environment_test", deps = [":environment"])
