        "//waffle/simulation/common:backend",
        "//waffle/simulation/photonics/characterization:directional_publication",
        "//waffle/simulation/photonics/characterization:directional_recipe",
        "//waffle/simulation/photonics/characterization:mmi",
        "//waffle/simulation/photonics/characterization:publication",
        "//waffle/simulation/photonics/characterization:recipe",
    ],
