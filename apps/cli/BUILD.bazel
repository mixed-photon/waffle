load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("//tools:waffle.bzl", "waffle_py_test")

# `bazel run //apps/cli:waffle -- doctor`
py_binary(
    name = "waffle",
    srcs = ["main.py"],
    main = "main.py",
    visibility = ["//tools/visibility:apps_consumers"],
    deps = [
        ":lifecycle",
        "//waffle",
        "//waffle/artifacts:local",
        "//waffle/contracts/foundation:diagnostics",
        "//waffle/contracts/results:artifact",
