    name = "lifecycle",
    srcs = ["lifecycle.py"],
    visibility = ["//tools/visibility:apps_consumers"],
    deps = [
        "//waffle/artifacts:local",
        "//waffle/artifacts:store",
        "//waffle/characterization/calibration:power",
        "//waffle/contracts/component:definition",
        "//waffle/contracts/component:design",
        "//waffle/contracts/component:parameters",
        "//waffle/contracts/foundation:canonical",
        "//waffle/contracts/foundation:diagnostics",
        "//waffle/contracts/foundation:identity",
        "//waffle/contracts/foundation:records",
        "//waffle/contracts/foundation:result",
        "//waffle/contracts/foundation:units",
        "//waffle/contracts/mappings:mapping",
        "//waffle/contracts/models:capability",
        "//waffle/contracts/models:model",
        "//waffle/contracts/physics:approximations",
        "//waffle/contracts/results:artifact",
        "//waffle/contracts/results:dataset",
        "//waffle/contracts/results:provenance",
        "//waffle/experiments/bindings:resolve",
        "//waffle/experiments/bindings:store",
        "//waffle/experiments/measurements:ingest",
        "//waffle/layout/formats:publish",
